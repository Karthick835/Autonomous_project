# ─────────────────────────────────────────────────────────────
# Autonomous AI Scientist — Environment Variables
# Copy this file to .env and fill in your API keys.
# ─────────────────────────────────────────────────────────────

# ── LLM API Keys ─────────────────────────────────────────────
# At least ONE of these must be set for LLM-powered hypothesis generation.
# If none are set, the system falls back to the statistical heuristic engine.

# Google Gemini 2.5 Flash (recommended — free tier available)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI GPT-4o
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude 3.5 Sonnet
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Server Configuration ──────────────────────────────────────
PORT=5050
